# =============================================================================
# Ollama 环境变量样板（feature A / T04）
# 用法：复制为 ai/scripts/ollama.env 并填入本机差异值。
#   ⚠️ ai/scripts/ollama.env 已 gitignore（可能含本机路径/端口差异），不入库。
# 本机无差异时无需复制——start/status 脚本缺省会从 ai/config/ollama.yml 取默认值。
# =============================================================================

# 模型权重目录：指向仓库内 ai/models（保持「仓库整体搬走即可用」）
OLLAMA_MODELS=ai/models

# 监听地址：固定回环口，**禁止改成对外地址**（本地 AI 助手的零外发红线）
OLLAMA_HOST=127.0.0.1:11434

# 并发/内存（4B 量化模型在 8GB 内存机器上的保守值；富余可放宽）
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# 上下文长度与保活（助手为短问答，30m 保活足够且省内存）
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=30m

# 如处于公司代理网络，拉取模型可临时设置（部署脚本会读取）：
# HTTPS_PROXY=http://127.0.0.1:7890
